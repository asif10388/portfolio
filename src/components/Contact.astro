---
import { SITE } from "@/data/site"
import { clock } from "@/lib/time"

const lanes = [
  { key: "you", label: "Your day" },
  { key: "me", label: "My day" },
  { key: "both", label: "Both" },
]
---

<section class="contact" id="contact">
  <h2>
    It’s <span class="t" data-clock={SITE.homeZone}>{clock(SITE.homeZone, new Date())}</span> in {SITE.homeCity}.
    Let’s find a time.
  </h2>
  <div class="overlap">
    <p data-overlap aria-live="polite">
      My working day is {SITE.workingHours[0]}:00 to {SITE.workingHours[1]}:00 in {SITE.homeCity}, and I’m used to
      overlapping with teams in the Americas and Europe.
    </p>
    <div class="bars" aria-hidden="true">
      {
        lanes.map((l) => (
          <div class="lane">
            <span>{l.label}</span>
            <div class={`track ${l.key}`} data-lane={l.key}>
              <i data-seg hidden />
              <i data-seg hidden />
            </div>
          </div>
        ))
      }
      <div class="ticks"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
    </div>
  </div>
  <div class="reach">
    <a class="btn" href={SITE.calUrl} target="_blank" rel="noopener">
      Book a 15-minute call <span aria-hidden="true">→</span>
    </a>
    <span class="email">{SITE.email}</span>
    <a class="link" href={SITE.socials.github} target="_blank" rel="noopener">GitHub</a>
    <a class="link" href={SITE.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(80px, 10vw, 140px) 40px;
    display: grid;
    gap: 36px;
  }
  h2 {
    margin: 0;
    font-weight: 350;
    font-size: clamp(42px, 6.6vw, 88px);
    line-height: 1;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .t {
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: -0.04em;
    font-size: 0.86em;
    font-variant-numeric: tabular-nums;
  }
  .overlap {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    border-top: 1px solid var(--color-rule-strong);
    padding-top: 26px;
  }
  .overlap p {
    margin: 0;
    font-size: clamp(19px, 1.6vw, 22px);
    max-width: 52ch;
  }
  .bars {
    display: grid;
    gap: 12px;
  }
  .lane {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-2);
  }
  .track {
    position: relative;
    height: 14px;
    border: 1px solid var(--color-rule-strong);
  }
  .track i {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--color-ink);
  }
  .track i[hidden] {
    display: none;
  }
  .me i {
    background: repeating-linear-gradient(135deg, var(--color-ink) 0 2px, transparent 2px 6px);
  }
  .both i {
    background: var(--color-spot);
  }
  .ticks {
    display: flex;
    justify-content: space-between;
    margin-left: calc(7.5em + 12px);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-ink-3);
  }
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 30px;
    align-items: center;
  }
  .email {
    font-family: var(--font-mono);
    font-size: 15px;
    user-select: all;
  }
  @media (max-width: 960px) {
    .overlap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
