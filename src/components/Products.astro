---
import { getCollection } from "astro:content"
import SectionHead from "./SectionHead.astro"
import { ethiopianToday } from "@/lib/time"

const places = (await getCollection("places")).sort((a, b) => a.data.order - b.data.order)
const productCount = places.reduce((n, p) => n + p.data.projects.length, 0)
const WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"]
const word = (n: number) => WORDS[n] ?? String(n)
const capital = (s: string) => s[0]!.toUpperCase() + s.slice(1)
const eth = ethiopianToday(new Date())
---

<section class="sec" id="products">
  <SectionHead title="Products people use">
    {capital(word(productCount))} products in {word(places.length)} countries, from national government services to the
    tools a marketing team opens every morning.
  </SectionHead>
  <div class="colhead label" aria-hidden="true"><span>Where, and for what</span><span>What I built</span></div>

  {
    places.map(({ data }) => (
      <article class="place">
        <div class="where">
          <h3 class="country">{data.country}</h3>
          {data.script && (
            <span class="script" lang={data.script.lang}>
              {data.script.text}
            </span>
          )}
          <span class="domain">{data.domain}</span>
          {data.live && (
            <span class="tag live">
              <span class="dot" aria-hidden="true" />
              Live
            </span>
          )}
          {data.home && (
            <span class="tag home">
              <span class="dot" aria-hidden="true" />
              Home desk
            </span>
          )}
        </div>
        <div class="what">
          {data.projects.map((p) => (
            <div class="proj">
              <span class="who">{p.who}</span>
              <h4>{p.title}</h4>
              <p>{p.body}</p>
              {p.figures.length > 0 && (
                <dl class="figures">
                  {p.figures.map((f) => (
                    <div>
                      <dt>{f.label}</dt>
                      <dd>{f.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {data.ethiopianDate && (
                <p class="aside">
                  Today in Ethiopia is <b data-eth>{eth.en}</b> (
                  <span class="et" lang="am" data-eth-am>
                    {eth.am}
                  </span>
                  ). The portal shows the Ethiopian date on every screen.
                </p>
              )}
              {p.link && (
                <a
                  class="more"
                  href={p.link.href}
                  {...(p.link.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}
                >
                  {p.link.label}
                </a>
              )}
            </div>
          ))}
        </div>
      </article>
    ))
  }
</section>

<style>
  .sec {
    padding-top: clamp(64px, 8vw, 104px);
  }
  .colhead,
  .place {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 48px;
  }
  .colhead {
    padding-block: 12px;
    border-bottom: 1px solid var(--color-rule);
  }
  .place {
    padding-block: 34px 38px;
    border-bottom: 1px solid var(--color-rule);
    transition: background-color 0.2s;
  }
  .place:hover {
    background: linear-gradient(90deg, transparent, var(--color-tint) 12%, var(--color-tint) 88%, transparent);
  }

  .where {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .country {
    margin: 0;
    font-weight: 400;
    font-size: clamp(32px, 3.4vw, 44px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .script {
    font-size: 20px;
    color: var(--color-ink-2);
    line-height: 1.3;
  }
  .script:lang(bn) {
    font-family: var(--font-bn);
  }
  .script:lang(am) {
    font-family: var(--font-et);
  }
  .domain {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    margin-top: 4px;
  }
  .tag {
    align-self: flex-start;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: inline-flex;
    gap: 7px;
    align-items: center;
  }
  .live {
    color: var(--color-ink);
  }
  .home {
    color: var(--color-spot);
  }

  .what {
    display: flex;
    flex-direction: column;
    gap: 26px;
    min-width: 0;
  }
  .proj {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .proj + .proj {
    border-top: 1px dashed var(--color-rule);
    padding-top: 24px;
  }
  .who {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-3);
  }
  h4 {
    margin: 0;
    font-weight: 450;
    font-size: clamp(24px, 2.2vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .proj p {
    margin: 0;
    color: var(--color-ink-2);
    max-width: 60ch;
  }
  .figures {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 34px;
    margin: 4px 0 0;
  }
  .figures div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  dt {
    order: 2;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-ink-3);
  }
  dd {
    order: 1;
    margin: 0;
    font-size: 26px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .aside {
    font-size: 15.5px;
    font-style: italic;
    border-left: 2px solid var(--color-spot);
    padding-left: 12px;
  }
  .aside b {
    font-style: normal;
    font-weight: 500;
    color: var(--color-ink);
  }
  .et {
    font-family: var(--font-et);
    font-style: normal;
  }
  .more {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 13px;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 960px) {
    .colhead {
      display: none;
    }
    .place {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
