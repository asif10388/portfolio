---
import { SITE } from "@/data/site"
---

<section class="hero" id="top">
  <p class="eyebrow label">{SITE.title}</p>
  <h1>
    <span class="nm">Asif Hossain <span class="last">Khan<span class="stop">.</span></span></span>
    <span class="line">
      I’ve built products in <em>government services</em>, <em>AI hiring</em>, <em>construction</em>,
      <em>marketing</em> and <em>climate tech</em>, for teams in Canada, Ethiopia, Lithuania, the&nbsp;UK, the&nbsp;US
      and Australia.
    </span>
  </h1>
  <p class="intro">
    I’m usually the first frontend engineer on a product, and still there when it ships. Two of the products below
    went from first commit to real users in four months. I work from Dhaka, and I’m used to keeping Canadian and
    European hours.
  </p>
  <div class="actions">
    <a class="btn" href={SITE.calUrl} target="_blank" rel="noopener">
      Book a 15-minute call <span aria-hidden="true">→</span>
    </a>
    <a class="link" href={SITE.resumeUrl}>Résumé, PDF</a>
    {
      SITE.availableForContract && (
        <span class="avail">
          <span class="dot" aria-hidden="true" />
          Open to select contract work
        </span>
      )
    }
  </div>
</section>

<style>
  .hero {
    text-align: center;
    padding-block: clamp(56px, 8vw, 104px) clamp(40px, 5vw, 64px);
    border-bottom: 1px solid var(--color-rule-strong);
  }
  .eyebrow {
    margin: 0 0 22px;
  }
  h1 {
    margin: 0;
    font-weight: 400;
  }
  .nm {
    display: block;
    font-weight: 800;
    font-size: clamp(54px, 13.4vw, 178px);
    line-height: 0.88;
    letter-spacing: -0.04em;
    font-variation-settings: "opsz" 72;
  }
  .last {
    display: block;
  }
  .stop {
    color: var(--color-spot);
  }
  .line {
    display: block;
    margin: 0.9em auto 0;
    max-width: 30ch;
    font-style: italic;
    font-weight: 300;
    font-size: clamp(26px, 3.3vw, 42px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-ink-2);
    text-wrap: balance;
  }
  .line em {
    font-style: normal;
    font-weight: 400;
    color: var(--color-ink);
  }
  .intro {
    margin: clamp(28px, 3.5vw, 40px) auto 0;
    max-width: 58ch;
    font-size: clamp(18px, 1.5vw, 20px);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 26px;
    margin-top: 28px;
  }
  .avail {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-2);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
</style>
