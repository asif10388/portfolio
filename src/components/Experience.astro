---
import SectionHead from "./SectionHead.astro"
import { ROLES, TOOLS } from "@/data/experience"
import { SITE } from "@/data/site"
---

<section class="sec" id="experience">
  <SectionHead title="Experience">
    The short version. The <a href={SITE.resumeUrl}>résumé</a> has the rest.
  </SectionHead>
  <div class="ledger">
    <table>
      <tbody>
        {
          ROLES.map((r) => (
            <tr>
              <td class="yr">{r.years}</td>
              <td>
                <span class="co">{r.company}</span>
                <span class="role">{r.role}</span>
              </td>
              <td class="loc">{r.where}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class="tools">
      {
        TOOLS.map((t) => (
          <div>
            <span class="label">{t.label}</span>
            <p>{t.items}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sec {
    padding-top: clamp(64px, 8vw, 104px);
  }
  .ledger {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 56px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  td {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-rule);
    vertical-align: baseline;
  }
  .yr {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-3);
    width: 8.5em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .co {
    font-size: 21px;
  }
  .role {
    display: block;
    font-size: 15px;
    color: var(--color-ink-2);
  }
  .loc {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-3);
    text-align: right;
    white-space: nowrap;
  }
  .tools {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 14px;
  }
  .tools div {
    display: grid;
    gap: 4px;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 16px;
  }
  .tools p {
    margin: 0;
    font-size: 17px;
  }
  @media (max-width: 960px) {
    .ledger {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 620px) {
    .loc {
      display: none;
    }
  }
</style>
